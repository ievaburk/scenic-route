# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OSM extracts and the derived graph — rebuildable from scripts/, and far too
# big for git. `npm run fetch:osm && npm run build:graph` regenerates them.
/data/

# MapLibre's worker, copied out of node_modules by predev/prebuild so the
# browser can fetch it. See scripts/copy-map-worker.ts.
/public/maplibre/

# Per-machine Claude Code settings — holds this machine's absolute nvm path.
# .claude/launch.json is committed; this one isn't.
/.claude/settings.local.json

# The product definition and build plan is kept private deliberately — it's the
# strategy doc, not documentation. Code comments and AGENTS.md still cite it by
# section (PLAN.md §8 and so on); those references are for whoever has the file.
/PLAN.md
